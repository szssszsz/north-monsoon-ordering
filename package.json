{
  "name": "north-monsoon-ordering",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-editions.mjs",
    "start": "node server/index.mjs",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "precheck": "node scripts/compose-wind.mjs",
    "build:single": "node scripts/compose-wind.mjs && vite build",
    "build:classic": "node scripts/compose-wind.mjs && vite build --mode classic",
    "build:reverie": "node scripts/compose-wind.mjs && vite build --mode reverie"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "pg-mem": "^3.0.14",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
